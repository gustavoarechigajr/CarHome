<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen for the 1280x662dp content area. Colors, gradients and fonts are applied
     in HomeActivity.applyTheme() from the active CarTheme, so this file is structure only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <!-- Android Auto tile -->
        <FrameLayout
            android:id="@+id/aa_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Start Android Auto"
            android:focusable="true">

            <dev.gus.carhome.RingsView
                android:id="@+id/rings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="36dp">

                <ImageView
                    android:id="@+id/aa_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car_wireless" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/aa_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="0.86"
                    android:text="Android\nAuto"
                    android:textSize="72sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/aa_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waiting for phone"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/aa_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap to start"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/aa_play"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:id="@+id/aa_play_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="40dp"
            android:layout_height="0dp" />

        <!-- Clock + now playing, on the album-color wash -->
        <LinearLayout
            android:id="@+id/now_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.08"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textSize="76sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, MMM d"
                    android:format24Hour="EEE, MMM d"
                    android:textSize="22sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/now_row"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/track"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="19sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/progress_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textSize="15sp" />

                <dev.gus.carhome.ProgressLine
                    android:id="@+id/progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prev"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Previous track"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/play"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:contentDescription="Play"
                    android:elevation="4dp"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/next"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Next track"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dock_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp" />

    <!-- Dock: each tile holds its icon and label together -->
    <LinearLayout
        android:id="@+id/dock"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <LinearLayout android:id="@+id/dock_music" style="@style/DockTile" android:contentDescription="Music">
            <ImageView android:id="@+id/dock_music_icon" style="@style/DockIcon" android:src="@drawable/ic_music" />
            <TextView android:id="@+id/dock_music_label" style="@style/DockText" android:text="Music" />
        </LinearLayout>

        <LinearLayout android:id="@+id/dock_phone" style="@style/DockTile" android:layout_marginStart="12dp" android:contentDescription="Phone">
            <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                <ImageView android:id="@+id/dock_phone_icon" style="@style/DockIcon" android:layout_gravity="center" android:src="@drawable/ic_phone" />
                <View android:id="@+id/phone_dot" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|end" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/dock_phone_label" style="@style/DockText" android:text="Phone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/dock_apps" style="@style/DockTile" android:layout_marginStart="12dp" android:contentDescription="Apps">
            <ImageView android:id="@+id/dock_apps_icon" style="@style/DockIcon" android:src="@drawable/ic_apps" />
            <TextView android:id="@+id/dock_apps_label" style="@style/DockText" android:text="Apps" />
        </LinearLayout>

        <LinearLayout android:id="@+id/dock_settings" style="@style/DockTile" android:layout_marginStart="12dp" android:contentDescription="Settings">
            <ImageView android:id="@+id/dock_settings_icon" style="@style/DockIcon" android:src="@drawable/ic_settings" />
            <TextView android:id="@+id/dock_settings_label" style="@style/DockText" android:text="Settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock_theme"
            style="@style/DockTile"
            android:layout_width="168dp"
            android:layout_marginStart="12dp"
            android:layout_weight="0">
            <ImageView android:id="@+id/dock_theme_icon" style="@style/DockIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_auto" />
            <TextView android:id="@+id/dock_theme_label" style="@style/DockText" android:layout_marginStart="10dp" android:text="Auto" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
